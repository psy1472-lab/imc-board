# Local development defaults
# SQLite path (relative to project root) or postgresql://... for Supabase
DATABASE_URL=sqlite:///./data/imc_dashboard.db

# Optional: override data directory (DB, uploads, ML cache)
# DATA_DIR=./data

# Model cache path (optional override)
# MODEL_CACHE_PATH=./data/models/volume_forecast_lgb.pkl

# Admin API password — change before production
IMC_ADMIN_PASSWORD=imc-admin

# Comma-separated origins for CORS (Vercel production + preview URLs)
# Comma-separated origins for CORS, or include *.vercel.app token
# CORS_ORIGINS=https://your-app.vercel.app,*.vercel.app
# CORS_ALLOW_VERCEL=true

# Max PDF upload size in MB
MAX_UPLOAD_MB=20

# Server port (Railway/Render inject PORT automatically)
PORT=8000

# Supabase (Phase 2 — Postgres / Storage)
SUPABASE_URL=
SUPABASE_SERVICE_KEY=

# Frontend (set in Vercel, not here)
# VITE_API_BASE=https://your-api.up.railway.app
